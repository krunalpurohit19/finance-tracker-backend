# Copy to .env.local for local runs (never commit real values). Production sets these in the host.

# Required everywhere. Generate with: openssl rand -base64 48
JWT_SECRET=

# Required in production (defaults match docker-compose.yml for local development)
DB_URL=jdbc:mysql://localhost:3307/finance_app?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=finance
DB_PASSWORD=
SERVER_PORT=4001
SPRING_PROFILES_ACTIVE=        # prod = JSON logs + trust the load balancer's forwarded headers
APP_CORS_ORIGINS=

# Email (SMTP). Empty MAIL_HOST = codes are written to the log instead of emailed.
# Amazon SES Mumbai: email-smtp.ap-south-1.amazonaws.com   Resend: smtp.resend.com
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Finance Tracker <no-reply@your-domain>

# Optional
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
DOCS_ENABLED=true              # Swagger UI at /docs
